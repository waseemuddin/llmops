### Semantic similarity

```bash
from sentence_transformers import SentenceTransformer
from sentence_transformers.util import cos_sim

model = SentenceTransformer("all-MiniLM-L6-v2")

sentences = [
    "Kubernetes manages containerized applications.",
    "K8s is used to orchestrate containers.",
    "Docker containers can run applications.",
    "The weather is very hot today.",
    "I bought a new refrigerator."
]

embeddings = model.encode(sentences)

query = embeddings[0]

print("QUERY:")
print(sentences[0])

print("\nSIMILARITY RESULTS")
print("-" * 70)

for sentence, embedding in zip(sentences[1:], embeddings[1:]):
    score = cos_sim(query, embedding).item()
    print(f"{score:.4f} | {sentence}")
```
python embedding_lab.py

### Build your first semantic search engine
vi semantic_search.py

```bash
from sentence_transformers import SentenceTransformer
from sentence_transformers.util import cos_sim

model = SentenceTransformer("all-MiniLM-L6-v2")

documents = [
    "Kubernetes automatically schedules containers across cluster nodes.",
    "Docker packages applications and dependencies into containers.",
    "Terraform is used for infrastructure as code.",
    "Prometheus collects metrics from applications and infrastructure.",
    "Grafana provides dashboards for monitoring systems.",
    "AWS EC2 provides virtual machines in the cloud.",
    "Kubernetes supports automatic scaling of application workloads.",
    "NVIDIA GPUs accelerate artificial intelligence workloads.",
    "PostgreSQL is a relational database management system.",
    "An ingress controller routes external traffic to Kubernetes services."
]

document_embeddings = model.encode(documents)

query = input("Enter your question: ")

query_embedding = model.encode(query)

scores = cos_sim(query_embedding, document_embeddings)[0]

results = sorted(
    zip(documents, scores),
    key=lambda x: x[1],
    reverse=True
)

print("\nTOP RESULTS")
print("=" * 70)

for document, score in results[:3]:
    print(f"\nScore: {score.item():.4f}")
    print(document)
```
